# Copy this file to .env and fill real values.
# .env has priority over config.php for these keys.

APP_SETTINGS_PASSWORD=admin123
APP_TIMEZONE=Europe/Yekaterinburg

# HTTP probe tuning (anti-bot friendly defaults)
CURL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
CURL_ACCEPT_LANGUAGE=ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7
CHECK_RETRY_WITH_GET=true
CHECK_AVAILABILITY_MODE=primary
CHECK_GET_BODY_LIMIT_BYTES=8192
ALERT_DOWN_FAILURES_THRESHOLD=3
ALERT_UP_SUCCESS_THRESHOLD=2

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=monitor@example.com
SMTP_FROM_NAME=Downdetector Monitor
SMTP_REPLY_TO=
SMTP_TIMEOUT=10

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=10
TELEGRAM_API_BASE=https://api.telegram.org
